NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://infrapulse:infrapulse_dev@localhost:5432/infrapulse?schema=public
JWT_SECRET=
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@infrapulse.local
ADMIN_PASSWORD=
ADMIN_NAME=InfraPulse Admin
DEMO_MODE=true
RATE_LIMIT_PUBLIC_MAX=120
RATE_LIMIT_AUTH_MAX=20
AWS_REGION=
# Optional; unset uses the standard AWS SDK credential provider chain.
AWS_PROFILE=
AWS_SYNC_INTERVAL_MINUTES=60
# Optional SMTP transport (leave unset to use in-app notifications only)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=InfraPulse
# Optional AI investigation provider (OpenAI-compatible Chat Completions API)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_MS=30000
AI_ANALYSIS_ENABLED=true
INCIDENT_UNACKNOWLEDGED_SEC=900
