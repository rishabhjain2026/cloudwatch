generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  VIEWER
}

enum ServerStatus {
  HEALTHY
  WARNING
  CRITICAL
  OFFLINE
  UNKNOWN
}

enum AgentStatus {
  ACTIVE
  REVOKED
  PENDING
}

enum MetricKind {
  CPU
  MEM
  DISK
  NET_IN
  NET_OUT
  LOAD
  TEMP
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum IncidentStatus {
  DETECTED
  OPEN
  ACKNOWLEDGED
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum IncidentPriority {
  P0
  P1
  P2
  P3
}

enum IncidentAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

enum IncidentChatRole {
  USER
  ASSISTANT
}

enum PostmortemStatus {
  DRAFT
  AI_DRAFT
  APPROVED
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum AlertMemberType {
  INTERNAL
  EXTERNAL
}

enum NotificationDeliveryStatus {
  PENDING
  RETRYING
  SENDING
  SENT
  FAILED
}

enum RemediationStatus {
  SUGGESTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXECUTING
  VERIFIED
  FAILED
}

enum CostSource {
  ESTIMATE
  AWS_CE
}

enum DeploymentStatus {
  PENDING
  SUCCESS
  FAILED
  ROLLED_BACK
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  permissions Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  roleId       String
  role         Role           @relation(fields: [roleId], references: [id])
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  alertsAcked  Alert[]        @relation("AlertAckedBy")
  incidents    Incident[]     @relation("IncidentAssignee")
  incidentEvents IncidentEvent[]
  notifications Notification[]
  auditLogs    AuditLog[]
  remediationsRequested RemediationAction[] @relation("RemediationRequestedBy")
  remediationsApproved  RemediationAction[] @relation("RemediationApprovedBy")
  alertRules   AlertRule[]
  alertTeamMember AlertTeamMember?
  alertEvents AlertEvent[]
  alertRoutingRules AlertRoutingRule[]
  incidentAnalysesRequested IncidentAIAnalysis[] @relation("IncidentAIAnalysisRequester")
  incidentChatMessages IncidentAIChatMessage[]
  incidentPostmortemsResponsible IncidentPostmortem[] @relation("PostmortemResponsible")
  incidentPostmortemsApproved IncidentPostmortem[] @relation("PostmortemApproved")
  incidentAutomationRules IncidentAutomationRule[] @relation("IncidentAutomationCreator")

  @@index([roleId])
}

model Server {
  id              String            @id @default(cuid())
  name            String
  hostname        String?
  os              String?
  environment     String?
  region          String?
  provider        String?
  awsInstanceId   String?           @unique
  awsState        String?
  awsInstanceType String?
  awsAvailabilityZone String?
  awsLaunchTime  DateTime?
  awsSyncedAt    DateTime?
  ipAddress       String?
  publicIpAddress String?
  dockerEnabled   Boolean           @default(false)
  dockerAvailable Boolean?
  dockerEngineVersion String?
  dockerApiVersion String?
  dockerRunningContainers Int?
  dockerStoppedContainers Int?
  dockerTotalContainers Int?
  dockerImageCount Int?
  status          ServerStatus      @default(UNKNOWN)
  isDemo          Boolean           @default(false)
  lastHeartbeatAt DateTime?
  registeredAt    DateTime          @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  agent           Agent?
  metrics         MetricSample[]
  containers      DockerContainer[]
  dockerHeartbeats DockerAgentHeartbeat[]
  alerts          Alert[]
  incidents       Incident[]
  logs            LogEntry[]
  anomalies       Anomaly[]
  costs           InfrastructureCost[]

  @@index([isDemo, status])
  @@index([lastHeartbeatAt])
  @@index([dockerEnabled, lastHeartbeatAt])
}

model AwsResource {
  id               String   @id @default(cuid())
  accountId        String
  identity         String
  arn              String?
  service          String
  resourceType     String
  resourceId       String
  name             String?
  region           String?
  status           String?
  metadata         Json?
  lastDiscoveredAt DateTime @default(now())
  missingSince     DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([accountId, identity])
  @@index([service, region])
  @@index([resourceType, status])
  @@index([lastDiscoveredAt])
  @@index([missingSince])
}

model AwsSyncRun {
  id                       String    @id @default(cuid())
  status                   String
  coverageStatus           String
  startedAt                DateTime  @default(now())
  completedAt              DateTime?
  resourcesDiscovered      Int       @default(0)
  resourcesCreated         Int       @default(0)
  resourcesUpdated         Int       @default(0)
  servicesQueried          Json      @default("[]")
  serviceErrors            Json      @default("[]")
  unsupportedResourceTypes Json      @default("[]")
  unintegratedResourceTypes Json    @default("[]")
  incompleteRegions        Json      @default("[]")
  resourceExplorerStatus   Json?
  error                    String?

  @@index([startedAt])
  @@index([status, startedAt])
}

model Agent {
  id          String      @id @default(cuid())
  serverId    String      @unique
  server      Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  tokenHash   String
  tokenPrefix String
  status      AgentStatus @default(PENDING)
  permissions Json        @default("[]")
  lastSeenAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([tokenPrefix])
  @@index([status])
}

model MetricSample {
  id          String     @id @default(cuid())
  serverId    String
  server      Server     @relation(fields: [serverId], references: [id], onDelete: Cascade)
  kind        MetricKind
  value       Float
  unit        String     @default("%")
  meta        Json?
  collectedAt DateTime
  createdAt   DateTime   @default(now())

  @@index([serverId, kind, collectedAt])
  @@index([collectedAt])
}

model DockerContainer {
  id            String   @id @default(cuid())
  serverId      String
  server        Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  containerId   String
  name          String
  image         String?
  state         String
  health        String?
  cpuPercent    Float?
  memUsageMb    Float?
  restartCount  Int      @default(0)
  startedAt     DateTime?
  createdAtDocker DateTime?
  lastSeenAt    DateTime?
  missingSince  DateTime?
  memoryUsageBytes BigInt?
  memoryLimitBytes BigInt?
  networkRxBytes BigInt?
  networkTxBytes BigInt?
  blockReadBytes BigInt?
  blockWriteBytes BigInt?
  ports         Json?
  networks      Json?
  mounts        Json?
  metrics       DockerContainerMetric[]
  raw           Json?
  syncedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([serverId, containerId])
  @@index([serverId, state])
  @@index([serverId, missingSince, lastSeenAt])
}

model DockerContainerMetric {
  id             String          @id @default(cuid())
  containerDbId  String
  container      DockerContainer @relation(fields: [containerDbId], references: [id], onDelete: Cascade)
  cpuPercent     Float?
  memoryUsageBytes BigInt?
  memoryLimitBytes BigInt?
  memoryPercent  Float?
  networkRxBytes BigInt?
  networkTxBytes BigInt?
  blockReadBytes BigInt?
  blockWriteBytes BigInt?
  collectedAt    DateTime         @default(now())
  createdAt      DateTime         @default(now())

  @@index([containerDbId, collectedAt])
  @@index([collectedAt])
}

model DockerAgentHeartbeat {
  id             String   @id @default(cuid())
  serverId       String
  server         Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  dockerAvailable Boolean
  dockerError    String?
  engineVersion  String?
  apiVersion     String?
  containerCount Int?
  imageCount     Int?
  receivedAt     DateTime @default(now())

  @@index([serverId, receivedAt])
}

model AlertRule {
  id           String   @id @default(cuid())
  name         String
  description  String?
  category     String   @default("INFRASTRUCTURE")
  resourceType String?
  resourceId   String?
  alertType    String   @default("METRIC_THRESHOLD")
  metric       String?
  operator     String   @default("gt")
  threshold    Float?
  evaluationDurationSec Int @default(0)
  severity     Severity
  cooldownSec  Int      @default(300)
  enabled      Boolean  @default(true)
  isDemo       Boolean  @default(false)
  deletedAt    DateTime?
  createdById  String?
  createdBy    User?    @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  alerts       Alert[]

  @@index([enabled, category, alertType])
  @@index([resourceType, resourceId])
}

model Alert {
  id            String      @id @default(cuid())
  ruleId        String?
  rule          AlertRule?  @relation(fields: [ruleId], references: [id])
  serverId      String?
  server        Server?     @relation(fields: [serverId], references: [id])
  apiMonitorId  String?
  apiMonitor    ApiMonitor? @relation(fields: [apiMonitorId], references: [id])
  category      String      @default("INFRASTRUCTURE")
  alertType     String      @default("METRIC_THRESHOLD")
  resourceType  String?
  resourceId    String?
  resourceName  String?
  deduplicationKey String?  @unique
  title         String
  description   String?
  severity      Severity
  status        AlertStatus @default(OPEN)
  metricValue   Float?
  threshold     Float?
  evaluationDurationSec Int?
  lastEvaluatedAt DateTime?
  lastNotifiedAt DateTime?
  occurrenceCount Int      @default(1)
  isDemo        Boolean     @default(false)
  triggeredAt   DateTime    @default(now())
  resolvedAt    DateTime?
  ackAt         DateTime?
  ackById       String?
  ackBy         User?       @relation("AlertAckedBy", fields: [ackById], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  incidents     IncidentAlert[]
  events        AlertEvent[]
  deliveries    NotificationDelivery[]
  notifications Notification[]

  @@index([status, severity, triggeredAt])
  @@index([serverId, status])
  @@index([isDemo])
  @@index([category, alertType, status, triggeredAt])
  @@index([resourceType, resourceId, status])
}

model AlertEvent {
  id        String   @id @default(cuid())
  alertId   String
  alert     Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  type      String
  message   String
  meta      Json?
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([alertId, createdAt])
  @@index([type, createdAt])
}

model AlertTeamMember {
  id          String          @id @default(cuid())
  name        String
  email       String          @unique
  designation String?
  memberType  AlertMemberType
  userId      String?         @unique
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  isActive    Boolean         @default(true)
  preferences Json            @default("{\"inApp\":true,\"email\":true,\"emailOnCritical\":true,\"emailOnWarning\":true,\"emailOnInfo\":false,\"emailOnResolution\":false}")
  recipients  AlertRoutingRecipient[]
  deliveries  NotificationDelivery[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([memberType, isActive])
}

model AlertRoutingRule {
  id           String   @id @default(cuid())
  name         String
  description  String?
  category     String?
  resourceType String?
  resourceId   String?
  alertType    String?
  severities   Json     @default("[\"CRITICAL\",\"HIGH\",\"MEDIUM\",\"LOW\"]")
  channels     Json     @default("[\"IN_APP\"]")
  priority     Int      @default(100)
  enabled      Boolean  @default(true)
  isFallback   Boolean  @default(false)
  deletedAt    DateTime?
  createdById  String?
  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  recipients   AlertRoutingRecipient[]
  deliveries   NotificationDelivery[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([enabled, category, priority])
  @@index([resourceType, resourceId, enabled])
  @@index([isFallback, enabled])
}

model AlertRoutingRecipient {
  routingRuleId String
  routingRule   AlertRoutingRule @relation(fields: [routingRuleId], references: [id], onDelete: Cascade)
  memberId      String
  member        AlertTeamMember  @relation(fields: [memberId], references: [id], onDelete: Restrict)
  createdAt     DateTime         @default(now())

  @@id([routingRuleId, memberId])
  @@index([memberId])
}

model Incident {
  id           String         @id @default(cuid())
  publicId     String         @unique
  title        String
  description  String?
  severity     Severity
  priority     IncidentPriority @default(P2)
  status       IncidentStatus @default(DETECTED)
  category     String @default("INFRASTRUCTURE")
  impactDescription String?
  resourceType String?
  resourceId   String?
  resourceName String?
  correlationKey String?
  reopenedCount Int @default(0)
  lastReopenedAt DateTime?
  rootCause String?
  resolutionDescription String?
  actionsTaken String?
  preventiveActions String?
  ackAt DateTime?
  investigatingAt DateTime?
  assigneeId   String?
  assignee     User?          @relation("IncidentAssignee", fields: [assigneeId], references: [id])
  serverId     String?
  server       Server?        @relation(fields: [serverId], references: [id])
  isDemo       Boolean        @default(false)
  isPublic     Boolean        @default(false)
  detectedAt   DateTime       @default(now())
  resolvedAt   DateTime?
  closedAt     DateTime?
  mttaMs       Int?
  mttrMs       Int?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  events       IncidentEvent[]
  alerts       IncidentAlert[]
  analyses     IncidentAIAnalysis[]
  chatMessages IncidentAIChatMessage[]
  postmortem   IncidentPostmortem?
  notifications Notification[]
  deliveries NotificationDelivery[]
  logs         LogEntry[]
  anomalies    Anomaly[]

  @@index([status, severity])
  @@index([isDemo])
  @@index([category, status, detectedAt])
  @@index([resourceType, resourceId, status])
  @@index([correlationKey, status, detectedAt])
  @@index([assigneeId, status])
}

model IncidentEvent {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type       String
  message    String
  meta       Json?
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  previousStatus String?
  newStatus String?
  createdAt  DateTime @default(now())

  @@index([incidentId, createdAt])
}

model IncidentAlert {
  incidentId String
  alertId    String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  alert      Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([incidentId, alertId])
}

model IncidentAutomationRule {
  id String @id @default(cuid())
  name String
  category String?
  alertType String?
  resourceType String?
  minimumSeverity Severity @default(CRITICAL)
  enabled Boolean @default(true)
  correlationWindowSec Int @default(900)
  correlateByResource Boolean @default(true)
  correlateByCategory Boolean @default(true)
  correlateByAlertType Boolean @default(false)
  createdById String?
  createdBy User? @relation("IncidentAutomationCreator", fields:[createdById], references:[id], onDelete:SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, category, alertType])
}

model IncidentAIAnalysis {
  id String @id @default(cuid())
  incidentId String
  incident Incident @relation(fields:[incidentId], references:[id], onDelete:Cascade)
  requestedById String?
  requestedBy User? @relation("IncidentAIAnalysisRequester", fields:[requestedById], references:[id], onDelete:SetNull)
  status IncidentAnalysisStatus @default(PENDING)
  attemptCount Int @default(0)
  provider String
  model String
  version Int
  result Json?
  failureCode String?
  requestedAt DateTime @default(now())
  startedAt DateTime?
  completedAt DateTime?
  chatMessages IncidentAIChatMessage[]
  postmortems IncidentPostmortem[]

  @@unique([incidentId, version])
  @@index([incidentId, status, requestedAt])
}

model IncidentAIChatMessage {
  id String @id @default(cuid())
  incidentId String
  incident Incident @relation(fields:[incidentId], references:[id], onDelete:Cascade)
  analysisId String?
  analysis IncidentAIAnalysis? @relation(fields:[analysisId], references:[id], onDelete:SetNull)
  userId String?
  user User? @relation(fields:[userId], references:[id], onDelete:SetNull)
  role IncidentChatRole
  content String
  createdAt DateTime @default(now())

  @@index([incidentId, createdAt])
  @@index([analysisId, createdAt])
}

model IncidentPostmortem {
  id String @id @default(cuid())
  incidentId String @unique
  incident Incident @relation(fields:[incidentId], references:[id], onDelete:Cascade)
  summary String?
  rootCause String?
  impact String?
  startedAt DateTime?
  detectedAt DateTime?
  acknowledgedAt DateTime?
  resolvedAt DateTime?
  downtimeMs Int?
  resolutionSteps String?
  lessonsLearned String?
  preventiveActions String?
  responsibleUserId String?
  responsibleUser User? @relation("PostmortemResponsible", fields:[responsibleUserId], references:[id], onDelete:SetNull)
  status PostmortemStatus @default(DRAFT)
  aiDraft Boolean @default(false)
  sourceAnalysisId String?
  sourceAnalysis IncidentAIAnalysis? @relation(fields:[sourceAnalysisId], references:[id], onDelete:SetNull)
  approvedById String?
  approvedBy User? @relation("PostmortemApproved", fields:[approvedById], references:[id], onDelete:SetNull)
  approvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
}

model LogEntry {
  id            String    @id @default(cuid())
  serverId      String?
  server        Server?   @relation(fields: [serverId], references: [id])
  application   String?
  level         LogLevel
  message       String
  maskedMessage String
  incidentId    String?
  incident      Incident? @relation(fields: [incidentId], references: [id])
  isDemo        Boolean   @default(false)
  collectedAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@index([collectedAt, level])
  @@index([serverId, collectedAt])
  @@index([isDemo])
}

model ApiMonitor {
  id             String     @id @default(cuid())
  name           String
  url            String
  method         String     @default("GET")
  intervalSec    Int        @default(60)
  enabled        Boolean    @default(true)
  isDemo         Boolean    @default(false)
  expectedStatus Int        @default(200)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  checks         ApiCheck[]
  alerts         Alert[]
  anomalies      Anomaly[]

  @@index([enabled, isDemo])
}

model ApiCheck {
  id                String     @id @default(cuid())
  apiMonitorId      String
  apiMonitor        ApiMonitor @relation(fields: [apiMonitorId], references: [id], onDelete: Cascade)
  statusCode        Int?
  latencyMs         Int?
  success           Boolean
  error             String?
  sslDaysRemaining  Int?
  checkedAt         DateTime   @default(now())

  @@index([apiMonitorId, checkedAt])
}

model Deployment {
  id            String           @id @default(cuid())
  appName       String
  version       String
  environment   String
  status        DeploymentStatus @default(PENDING)
  commitId      String?
  commitMessage String?
  webhookSource String?
  isDemo        Boolean          @default(false)
  deployedAt    DateTime         @default(now())
  meta          Json?
  createdAt     DateTime         @default(now())

  @@index([appName, deployedAt])
  @@index([isDemo])
}

model Anomaly {
  id               String      @id @default(cuid())
  serverId         String?
  server           Server?     @relation(fields: [serverId], references: [id])
  apiMonitorId     String?
  apiMonitor       ApiMonitor? @relation(fields: [apiMonitorId], references: [id])
  metric           String
  baseline         Float
  actual           Float
  zScore           Float?
  detectedAt       DateTime    @default(now())
  relatedIncidentId String?
  relatedIncident  Incident?   @relation(fields: [relatedIncidentId], references: [id])
  isDemo           Boolean     @default(false)

  @@index([detectedAt])
  @@index([isDemo])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String?
  user      User?               @relation(fields: [userId], references: [id])
  alertId   String?
  alert     Alert?              @relation(fields: [alertId], references: [id], onDelete: SetNull)
  incidentId String?
  incident Incident? @relation(fields:[incidentId], references:[id], onDelete:SetNull)
  deduplicationKey String?      @unique
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  readAt    DateTime?
  meta      Json?
  createdAt DateTime            @default(now())

  @@index([userId, readAt])
  @@index([alertId, createdAt])
  @@index([incidentId, createdAt])
}

model NotificationDelivery {
  id             String                    @id @default(cuid())
  alertId        String?
  alert          Alert?                    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  incidentId     String?
  incident       Incident?                 @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  memberId       String
  member         AlertTeamMember           @relation(fields: [memberId], references: [id], onDelete: Restrict)
  routingRuleId  String?
  routingRule    AlertRoutingRule?         @relation(fields: [routingRuleId], references: [id], onDelete: SetNull)
  channel        NotificationChannel
  recipientEmail String?
  subject String?
  body String?
  status         NotificationDeliveryStatus @default(PENDING)
  deduplicationKey String                  @unique
  attemptCount   Int                       @default(0)
  nextAttemptAt DateTime?
  lockedUntil    DateTime?
  lastAttemptAt DateTime?
  sentAt         DateTime?
  lastError      String?
  eventType      String                    @default("ALERT_FIRING")
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  attempts       NotificationAttempt[]

  @@index([status, nextAttemptAt])
  @@index([alertId, createdAt])
  @@index([incidentId, createdAt])
  @@index([memberId, createdAt])
}

model NotificationAttempt {
  id         String              @id @default(cuid())
  deliveryId String
  delivery   NotificationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  attempt    Int
  status     NotificationDeliveryStatus
  errorCode  String?
  attemptedAt DateTime            @default(now())

  @@unique([deliveryId, attempt])
  @@index([attemptedAt, status])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id])
  action       String
  resourceType String
  resourceId   String?
  ip           String?
  meta         Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([resourceType, resourceId])
}

model RemediationAction {
  id            String            @id @default(cuid())
  type          String
  targetType    String
  targetId      String
  status        RemediationStatus @default(SUGGESTED)
  requestedById String?
  requestedBy   User?             @relation("RemediationRequestedBy", fields: [requestedById], references: [id])
  approvedById  String?
  approvedBy    User?             @relation("RemediationApprovedBy", fields: [approvedById], references: [id])
  evidence      Json?
  result        Json?
  createdAt     DateTime          @default(now())
  executedAt    DateTime?
  updatedAt     DateTime          @updatedAt

  @@index([status, createdAt])
}

model DomainMonitor {
  id            String    @id @default(cuid())
  domain        String    @unique
  enabled       Boolean   @default(true)
  isDemo        Boolean   @default(false)
  lastStatus    String?
  sslExpiresAt  DateTime?
  hostnameMatch Boolean?
  httpStatus    Int?
  checkedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isDemo, enabled])
}

model InfrastructureCost {
  id          String     @id @default(cuid())
  serverId    String?
  server      Server?    @relation(fields: [serverId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  amountUsd   Float
  source      CostSource @default(ESTIMATE)
  breakdown   Json?
  isDemo      Boolean    @default(false)
  createdAt   DateTime   @default(now())

  @@index([periodStart, periodEnd])
  @@index([isDemo])
