generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  VIEWER
}

enum ServerStatus {
  HEALTHY
  WARNING
  CRITICAL
  OFFLINE
  UNKNOWN
}

enum AgentStatus {
  ACTIVE
  REVOKED
  PENDING
}

enum MetricKind {
  CPU
  MEM
  DISK
  NET_IN
  NET_OUT
  LOAD
  TEMP
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum IncidentStatus {
  DETECTED
  OPEN
  ACKNOWLEDGED
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum RemediationStatus {
  SUGGESTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXECUTING
  VERIFIED
  FAILED
}

enum CostSource {
  ESTIMATE
  AWS_CE
}

enum DeploymentStatus {
  PENDING
  SUCCESS
  FAILED
  ROLLED_BACK
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  permissions Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  roleId       String
  role         Role           @relation(fields: [roleId], references: [id])
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  alertsAcked  Alert[]        @relation("AlertAckedBy")
  incidents    Incident[]     @relation("IncidentAssignee")
  incidentEvents IncidentEvent[]
  notifications Notification[]
  auditLogs    AuditLog[]
  remediationsRequested RemediationAction[] @relation("RemediationRequestedBy")
  remediationsApproved  RemediationAction[] @relation("RemediationApprovedBy")
  alertRules   AlertRule[]

  @@index([roleId])
}

model Server {
  id              String            @id @default(cuid())
  name            String
  hostname        String?
  os              String?
  environment     String?
  region          String?
  provider        String?
  awsInstanceId   String?           @unique
  awsState        String?
  awsInstanceType String?
  awsAvailabilityZone String?
  awsLaunchTime  DateTime?
  awsSyncedAt    DateTime?
  ipAddress       String?
  publicIpAddress String?
  status          ServerStatus      @default(UNKNOWN)
  isDemo          Boolean           @default(false)
  lastHeartbeatAt DateTime?
  registeredAt    DateTime          @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  agent           Agent?
  metrics         MetricSample[]
  containers      DockerContainer[]
  alerts          Alert[]
  incidents       Incident[]
  logs            LogEntry[]
  anomalies       Anomaly[]
  costs           InfrastructureCost[]

  @@index([isDemo, status])
  @@index([lastHeartbeatAt])
}

model AwsResource {
  id               String   @id @default(cuid())
  accountId        String
  identity         String
  arn              String?
  service          String
  resourceType     String
  resourceId       String
  name             String?
  region           String?
  status           String?
  metadata         Json?
  lastDiscoveredAt DateTime @default(now())
  missingSince     DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([accountId, identity])
  @@index([service, region])
  @@index([resourceType, status])
  @@index([lastDiscoveredAt])
  @@index([missingSince])
}

model AwsSyncRun {
  id                       String    @id @default(cuid())
  status                   String
  coverageStatus           String
  startedAt                DateTime  @default(now())
  completedAt              DateTime?
  resourcesDiscovered      Int       @default(0)
  resourcesCreated         Int       @default(0)
  resourcesUpdated         Int       @default(0)
  servicesQueried          Json      @default("[]")
  serviceErrors            Json      @default("[]")
  unsupportedResourceTypes Json      @default("[]")
  unintegratedResourceTypes Json    @default("[]")
  incompleteRegions        Json      @default("[]")
  resourceExplorerStatus   Json?
  error                    String?

  @@index([startedAt])
  @@index([status, startedAt])
}

model Agent {
  id          String      @id @default(cuid())
  serverId    String      @unique
  server      Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  tokenHash   String
  tokenPrefix String
  status      AgentStatus @default(PENDING)
  permissions Json        @default("[]")
  lastSeenAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([tokenPrefix])
  @@index([status])
}

model MetricSample {
  id          String     @id @default(cuid())
  serverId    String
  server      Server     @relation(fields: [serverId], references: [id], onDelete: Cascade)
  kind        MetricKind
  value       Float
  unit        String     @default("%")
  meta        Json?
  collectedAt DateTime
  createdAt   DateTime   @default(now())

  @@index([serverId, kind, collectedAt])
  @@index([collectedAt])
}

model DockerContainer {
  id            String   @id @default(cuid())
  serverId      String
  server        Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  containerId   String
  name          String
  image         String?
  state         String
  health        String?
  cpuPercent    Float?
  memUsageMb    Float?
  restartCount  Int      @default(0)
  startedAt     DateTime?
  raw           Json?
  syncedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([serverId, containerId])
  @@index([serverId, state])
}

model AlertRule {
  id           String   @id @default(cuid())
  name         String
  metric       String
  operator     String
  threshold    Float
  severity     Severity
  cooldownSec  Int      @default(300)
  enabled      Boolean  @default(true)
  isDemo       Boolean  @default(false)
  createdById  String?
  createdBy    User?    @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  alerts       Alert[]

  @@index([enabled, metric])
}

model Alert {
  id            String      @id @default(cuid())
  ruleId        String?
  rule          AlertRule?  @relation(fields: [ruleId], references: [id])
  serverId      String?
  server        Server?     @relation(fields: [serverId], references: [id])
  apiMonitorId  String?
  apiMonitor    ApiMonitor? @relation(fields: [apiMonitorId], references: [id])
  title         String
  description   String?
  severity      Severity
  status        AlertStatus @default(OPEN)
  metricValue   Float?
  threshold     Float?
  isDemo        Boolean     @default(false)
  triggeredAt   DateTime    @default(now())
  resolvedAt    DateTime?
  ackAt         DateTime?
  ackById       String?
  ackBy         User?       @relation("AlertAckedBy", fields: [ackById], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  incidents     IncidentAlert[]

  @@index([status, severity, triggeredAt])
  @@index([serverId, status])
  @@index([isDemo])
}

model Incident {
  id           String         @id @default(cuid())
  publicId     String         @unique
  title        String
  description  String?
  severity     Severity
  status       IncidentStatus @default(DETECTED)
  assigneeId   String?
  assignee     User?          @relation("IncidentAssignee", fields: [assigneeId], references: [id])
  serverId     String?
  server       Server?        @relation(fields: [serverId], references: [id])
  isDemo       Boolean        @default(false)
  detectedAt   DateTime       @default(now())
  resolvedAt   DateTime?
  closedAt     DateTime?
  mttaMs       Int?
  mttrMs       Int?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  events       IncidentEvent[]
  alerts       IncidentAlert[]
  logs         LogEntry[]
  anomalies    Anomaly[]

  @@index([status, severity])
  @@index([isDemo])
}

model IncidentEvent {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type       String
  message    String
  meta       Json?
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  createdAt  DateTime @default(now())

  @@index([incidentId, createdAt])
}

model IncidentAlert {
  incidentId String
  alertId    String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  alert      Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@id([incidentId, alertId])
}

model LogEntry {
  id            String    @id @default(cuid())
  serverId      String?
  server        Server?   @relation(fields: [serverId], references: [id])
  application   String?
  level         LogLevel
  message       String
  maskedMessage String
  incidentId    String?
  incident      Incident? @relation(fields: [incidentId], references: [id])
  isDemo        Boolean   @default(false)
  collectedAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@index([collectedAt, level])
  @@index([serverId, collectedAt])
  @@index([isDemo])
}

model ApiMonitor {
  id             String     @id @default(cuid())
  name           String
  url            String
  method         String     @default("GET")
  intervalSec    Int        @default(60)
  enabled        Boolean    @default(true)
  isDemo         Boolean    @default(false)
  expectedStatus Int        @default(200)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  checks         ApiCheck[]
  alerts         Alert[]
  anomalies      Anomaly[]

  @@index([enabled, isDemo])
}

model ApiCheck {
  id                String     @id @default(cuid())
  apiMonitorId      String
  apiMonitor        ApiMonitor @relation(fields: [apiMonitorId], references: [id], onDelete: Cascade)
  statusCode        Int?
  latencyMs         Int?
  success           Boolean
  error             String?
  sslDaysRemaining  Int?
  checkedAt         DateTime   @default(now())

  @@index([apiMonitorId, checkedAt])
}

model Deployment {
  id            String           @id @default(cuid())
  appName       String
  version       String
  environment   String
  status        DeploymentStatus @default(PENDING)
  commitId      String?
  commitMessage String?
  webhookSource String?
  isDemo        Boolean          @default(false)
  deployedAt    DateTime         @default(now())
  meta          Json?
  createdAt     DateTime         @default(now())

  @@index([appName, deployedAt])
  @@index([isDemo])
}

model Anomaly {
  id               String      @id @default(cuid())
  serverId         String?
  server           Server?     @relation(fields: [serverId], references: [id])
  apiMonitorId     String?
  apiMonitor       ApiMonitor? @relation(fields: [apiMonitorId], references: [id])
  metric           String
  baseline         Float
  actual           Float
  zScore           Float?
  detectedAt       DateTime    @default(now())
  relatedIncidentId String?
  relatedIncident  Incident?   @relation(fields: [relatedIncidentId], references: [id])
  isDemo           Boolean     @default(false)

  @@index([detectedAt])
  @@index([isDemo])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String?
  user      User?               @relation(fields: [userId], references: [id])
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  readAt    DateTime?
  meta      Json?
  createdAt DateTime            @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id])
  action       String
  resourceType String
  resourceId   String?
  ip           String?
  meta         Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([resourceType, resourceId])
}

model RemediationAction {
  id            String            @id @default(cuid())
  type          String
  targetType    String
  targetId      String
  status        RemediationStatus @default(SUGGESTED)
  requestedById String?
  requestedBy   User?             @relation("RemediationRequestedBy", fields: [requestedById], references: [id])
  approvedById  String?
  approvedBy    User?             @relation("RemediationApprovedBy", fields: [approvedById], references: [id])
  evidence      Json?
  result        Json?
  createdAt     DateTime          @default(now())
  executedAt    DateTime?
  updatedAt     DateTime          @updatedAt

  @@index([status, createdAt])
}

model DomainMonitor {
  id            String    @id @default(cuid())
  domain        String    @unique
  enabled       Boolean   @default(true)
  isDemo        Boolean   @default(false)
  lastStatus    String?
  sslExpiresAt  DateTime?
  hostnameMatch Boolean?
  httpStatus    Int?
  checkedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isDemo, enabled])
}

model InfrastructureCost {
  id          String     @id @default(cuid())
  serverId    String?
  server      Server?    @relation(fields: [serverId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  amountUsd   Float
  source      CostSource @default(ESTIMATE)
  breakdown   Json?
  isDemo      Boolean    @default(false)
  createdAt   DateTime   @default(now())

  @@index([periodStart, periodEnd])
  @@index([isDemo])
}
