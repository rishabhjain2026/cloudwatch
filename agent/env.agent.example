# Copy to .env.agent and provide values locally; never commit .env.agent.
INFRAPULSE_API_URL=https://infrapulse.example.com
INFRAPULSE_TOKEN=
INFRAPULSE_INTERVAL_SEC=30
INFRAPULSE_TIMEOUT_MS=10000
INFRAPULSE_DOCKER=true
INFRAPULSE_DOCKER_METRICS_INTERVAL_SEC=30
INFRAPULSE_DOCKER_INVENTORY_INTERVAL_SEC=60
# Windows Docker Desktop defaults to //./pipe/docker_engine.
# Linux defaults to /var/run/docker.sock.
# DOCKER_SOCKET=
